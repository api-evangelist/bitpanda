{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bitpanda Platform assets API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developer.bitpanda.com/v1/assets/:asset_id",
            "params": [
              {
                "name": "asset_id",
                "value": "",
                "type": "path",
                "description": "Asset ID"
              }
            ]
          },
          "docs": "Get asset information (name, symbol) by asset ID."
        }
      ]
    }
  ],
  "bundled": true
}